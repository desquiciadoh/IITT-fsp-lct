components:
  schemas:
    AnswerRequest:
      type: object
      properties:
        item_id:
          type: string
          format: uuid
        option_id:
          type: string
        value:
          type: string
        integrity: {}
      required:
      - item_id
    AnswerResponse:
      type: object
      properties:
        done:
          type: boolean
        next:
          $ref: '#/components/schemas/ItemView'
        result:
          $ref: '#/components/schemas/AssessmentResult'
      required:
      - done
    ApplicationCandidate:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        position:
          allOf:
          - $ref: '#/components/schemas/Vacancy'
          readOnly: true
        status:
          $ref: '#/components/schemas/ApplicationStatusEnum'
        note:
          type: string
          description: Cover letter or candidate note
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - position
      - updated_at
    ApplicationCreate:
      type: object
      properties:
        note:
          type: string
          default: ''
    ApplicationEmployer:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        candidate:
          allOf:
          - $ref: '#/components/schemas/TalentShort'
          readOnly: true
        status:
          $ref: '#/components/schemas/ApplicationStatusEnum'
        note:
          type: string
          description: Cover letter or candidate note
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - candidate
      - created_at
      - id
      - updated_at
    ApplicationStatusEnum:
      enum:
      - applied
      - reviewing
      - invited
      - rejected
      - hired
      - withdrawn
      type: string
      description: |-
        * `applied` - Applied
        * `reviewing` - Reviewing
        * `invited` - Invited
        * `rejected` - Rejected
        * `hired` - Hired
        * `withdrawn` - Withdrawn
    AssessmentEvidence:
      type: object
      properties:
        seq:
          type: integer
        level:
          type: string
        correct:
          type: boolean
          nullable: true
      required:
      - level
      - seq
    AssessmentFallback:
      type: object
      properties:
        grade:
          type: string
        mode:
          type: string
      required:
      - grade
      - mode
    AssessmentModeEnum:
      enum:
      - full
      - express
      type: string
      description: |-
        * `full` - Full
        * `express` - Express
    AssessmentPaginatedResponse:
      type: object
      properties:
        items:
          type: array
          items:
            $ref: '#/components/schemas/AssessmentResult'
        total:
          type: integer
        page:
          type: integer
        pages:
          type: integer
      required:
      - items
      - page
      - pages
      - total
    AssessmentResult:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        kind:
          $ref: '#/components/schemas/KindEnum'
        specialization:
          $ref: '#/components/schemas/SpecializationEnum'
        claimed_grade:
          $ref: '#/components/schemas/GradeEnum'
        mode:
          $ref: '#/components/schemas/AssessmentModeEnum'
        status:
          $ref: '#/components/schemas/AssessmentStatusEnum'
        theta:
          type: number
          format: double
          nullable: true
          description: θ estimate (EAP) on the IRT scale
        se:
          type: number
          format: double
          nullable: true
          description: Standard error of θ
        rating:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
          description: 'Sport-style rating: 1000 + 200θ'
        rating_ci:
          type: integer
          readOnly: true
        result_grade:
          oneOf:
          - $ref: '#/components/schemas/GradeEnum'
          - $ref: '#/components/schemas/BlankEnum'
        decision:
          oneOf:
          - $ref: '#/components/schemas/DecisionEnum'
          - $ref: '#/components/schemas/BlankEnum'
        promotion_unlocked:
          type: boolean
        counts_as_attempt:
          type: boolean
          description: False for fallback tests — failing does not burn a retake
        fallback:
          allOf:
          - $ref: '#/components/schemas/AssessmentFallback'
          nullable: true
          readOnly: true
        topics:
          type: array
          items:
            $ref: '#/components/schemas/AssessmentTopic'
          readOnly: true
        evidence:
          type: array
          items:
            $ref: '#/components/schemas/AssessmentEvidence'
          readOnly: true
        next_attempt_at:
          type: string
          nullable: true
          readOnly: true
        started_at:
          type: string
          format: date-time
          readOnly: true
        finished_at:
          type: string
          format: date-time
          nullable: true
      required:
      - claimed_grade
      - evidence
      - fallback
      - id
      - next_attempt_at
      - rating_ci
      - specialization
      - started_at
      - topics
    AssessmentSession:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        specialization:
          $ref: '#/components/schemas/SpecializationEnum'
        claimed_grade:
          $ref: '#/components/schemas/GradeEnum'
        kind:
          $ref: '#/components/schemas/KindEnum'
        mode:
