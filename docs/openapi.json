components:
  schemas:
    AnswerRequest:
      type: object
      properties:
        item_id:
          type: string
          format: uuid
        option_id:
          type: string
        value:
          type: string
        integrity: {}
      required:
      - item_id
    AnswerResponse:
      type: object
      properties:
        done:
          type: boolean
        next:
          $ref: '#/components/schemas/ItemView'
        result:
          $ref: '#/components/schemas/AssessmentResult'
      required:
      - done
    AssessmentResult:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        specialization:
          $ref: '#/components/schemas/SpecializationEnum'
        claimed_grade:
          $ref: '#/components/schemas/GradesEnum'
        kind:
          $ref: '#/components/schemas/KindEnum'
        mode:
          $ref: '#/components/schemas/ModeEnum'
        status:
          $ref: '#/components/schemas/Status61dEnum'
        theta:
          type: number
          format: double
          nullable: true
          description: θ estimate (EAP) on the IRT scale
        se:
          type: number
          format: double
          nullable: true
          description: Standard error of θ
        rating:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
          description: 'Sport-style rating: 1000 + 200θ'
        result_grade:
          oneOf:
          - $ref: '#/components/schemas/GradesEnum'
          - $ref: '#/components/schemas/BlankEnum'
        decision:
          oneOf:
          - $ref: '#/components/schemas/DecisionEnum'
          - $ref: '#/components/schemas/BlankEnum'
        promotion_unlocked:
          type: boolean
        counts_as_attempt:
          type: boolean
          description: False for fallback tests — failing does not burn a retake
        started_at:
          type: string
          format: date-time
          readOnly: true
        finished_at:
          type: string
          format: date-time
          nullable: true
      required:
      - claimed_grade
      - id
      - specialization
      - started_at
    AssessmentSession:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        specialization:
          $ref: '#/components/schemas/SpecializationEnum'
        claimed_grade:
          $ref: '#/components/schemas/GradesEnum'
        kind:
          $ref: '#/components/schemas/KindEnum'
        mode:
          $ref: '#/components/schemas/ModeEnum'
        status:
          $ref: '#/components/schemas/Status61dEnum'
        current:
          type: string
          readOnly: true
        theta:
          type: number
          format: double
          nullable: true
          description: θ estimate (EAP) on the IRT scale
        se:
          type: number
          format: double
          nullable: true
          description: Standard error of θ
        rating:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
          description: 'Sport-style rating: 1000 + 200θ'
        result_grade:
          oneOf:
          - $ref: '#/components/schemas/GradesEnum'
          - $ref: '#/components/schemas/BlankEnum'
        decision:
          oneOf:
          - $ref: '#/components/schemas/DecisionEnum'
          - $ref: '#/components/schemas/BlankEnum'
        promotion_unlocked:
          type: boolean
        started_at:
          type: string
          format: date-time
          readOnly: true
        finished_at:
          type: string
          format: date-time
          nullable: true
      required:
      - claimed_grade
      - current
      - id
      - specialization
      - started_at
    BlankEnum:
      enum:
      - ''
    CandidateContact:
      type: object
      properties:
        email:
          oneOf:
          - type: string
            format: email
            maxLength: 254
          - type: string
            maxLength: 0
        phone:
          type: string
          maxLength: 30
        telegram:
          type: string
          maxLength: 100
    CandidateProfile:
      type: object
      properties:
        public_id:
          type: string
          readOnly: true
        full_name:
          type: string
          maxLength: 255
        city:
          type: string
          maxLength: 100
        timezone:
          type: string
          maxLength: 50
        specialization:
          oneOf:
          - $ref: '#/components/schemas/SpecializationEnum'
          - $ref: '#/components/schemas/BlankEnum'
        claimed_grade:
          oneOf:
          - $ref: '#/components/schemas/GradesEnum'
          - $ref: '#/components/schemas/BlankEnum'
        years_experience:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,1})?$
          nullable: true
        roles:
          type: array
          items:
            type: string
            maxLength: 100
        work_formats:
          type: array
          items:
            $ref: '#/components/schemas/WorkFormatsEnum'
        salary_min:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
        salary_max:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
        salary_type:
          oneOf:
          - $ref: '#/components/schemas/SalaryTypeEnum'
          - $ref: '#/components/schemas/BlankEnum'
        salary_floor:
          type: integer
          maximum: 2147483647
          minimum: 0
          nullable: true
          description: Private minimum salary; offers below trigger a warning
        open_to_offers:
          type: boolean
        blind_mode:
          type: boolean
          description: Hide name and photo until offer acceptance
        blocked_company_ids:
          type: array
          items:
            type: string
            format: uuid
          description: Companies hidden from seeing this profile
        about:
          type: string
        experience_text:
          type: string
        completeness:
          type: integer
          readOnly: true
          description: Profile completeness 0-100
        contacts:
          type: string
          readOnly: true
        skills:
          type: string
