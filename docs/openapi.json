openapi: 3.0.3
info:
  title: FSP Draft API
  version: 1.0.0
  description: Reverse IT recruitment platform with verified achievement profiles
    (FSP)
paths:
  /api/assessments:
    get:
      operationId: assessments_list
      tags:
      - assessments
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssessmentPaginatedResponse'
          description: ''
    post:
      operationId: assessments_create
      tags:
      - assessments
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/StartAssessment'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/StartAssessment'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssessmentSession'
          description: ''
  /api/assessments/{id}:
    get:
      operationId: assessments_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - assessments
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssessmentSession'
          description: ''
  /api/assessments/{id}/answers:
    post:
      operationId: assessments_answers_create
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - assessments
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AnswerRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AnswerRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AnswerResponse'
          description: ''
  /api/assessments/{id}/fallback:
    post:
      operationId: assessments_fallback_create
      description: Fallback to a lower grade or short-test after an unconfirmed assessment
        (G5).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - assessments
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/FallbackRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/FallbackRequest'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssessmentResult'
          description: ''
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssessmentSession'
          description: ''
  /api/assessments/{id}/finish:
    post:
      operationId: assessments_finish_create
      description: Abandon / finish early an in-progress assessment.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - assessments
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssessmentResult'
          description: ''
  /api/assessments/{id}/result:
    get:
      operationId: assessments_result_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - assessments
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssessmentResult'
          description: ''
  /api/assessments/eligibility:
    get:
      operationId: assessments_eligibility_retrieve
      tags:
      - assessments
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EligibilityResponse'
          description: ''
  /api/auth/csrf:
    get:
      operationId: auth_csrf_retrieve
      tags:
      - auth
      security:
      - {}
      responses:
        '204':
          description: No response body
  /api/auth/fsp-id/callback:
    get:
      operationId: auth_fsp_id_callback_retrieve
      description: OIDC callback endpoint for FSP ID flow
      parameters:
      - in: query
        name: code
        schema:
          type: string
        description: Authorization code
        required: true
      - in: query
        name: state
        schema:
          type: string
        description: State parameter
        required: true
      tags:
      - auth
      security:
      - cookieAuth: []
      - {}
      responses:
        '302':
          description: No response body
        '409':
          description: FSP ID already linked to another account
  /api/auth/fsp-id/login:
    get:
      operationId: auth_fsp_id_login_retrieve
      description: Initiate OIDC flow for FSP ID login or linking
      parameters:
      - in: query
        name: intent
        schema:
          type: string
          default: login
        description: 'Intent: login or link'
      tags:
      - auth
      security:
      - cookieAuth: []
      - {}
      responses:
        '302':
          description: No response body
  /api/auth/login:
    post:
      operationId: auth_login_create
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
          description: ''
  /api/auth/logout:
    post:
      operationId: auth_logout_create
      tags:
      - auth
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/auth/register:
    post:
      operationId: auth_register_create
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Register'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Register'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RegisterResponse'
          description: ''
  /api/auth/verify-email:
    post:
      operationId: auth_verify_email_create
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VerifyEmailRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/VerifyEmailRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '204':
          description: No response body
  /api/candidates/me:
    get:
      operationId: candidates_me_retrieve
      tags:
      - candidates
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CandidateProfile'
          description: ''
    put:
      operationId: candidates_me_update
      tags:
      - candidates
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CandidateProfileUpdate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CandidateProfileUpdate'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CandidateProfile'
          description: ''
  /api/candidates/me/applications:
    get:
      operationId: candidates_me_applications_list
      description: List of candidate's own applications (Task BE-17).
      tags:
      - candidates
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ApplicationCandidate'
          description: ''
  /api/candidates/me/applications/{id}/withdraw:
    post:
      operationId: candidates_me_applications_withdraw_create
      description: Candidate withdraws their application (Task BE-17).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - candidates
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ApplicationCandidate'
          description: ''
  /api/candidates/me/card.pdf:
    get:
      operationId: candidates_me_card.pdf_retrieve
      description: Generate candidate player card PDF
      tags:
      - candidates
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/pdf:
              schema:
                type: string
                format: binary
          description: ''
  /api/candidates/me/consents:
    get:
      operationId: candidates_me_consents_retrieve
      tags:
      - candidates
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsentsResponse'
          description: ''
    put:
      operationId: candidates_me_consents_update
      tags:
      - candidates
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ConsentUpdate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ConsentUpdate'
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConsentsResponse'
          description: ''
  /api/candidates/me/grants:
    get:
      operationId: candidates_me_grants_list
      tags:
      - candidates
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ContactGrant'
          description: ''
  /api/candidates/me/grants/{id}/revoke:
    post:
      operationId: candidates_me_grants_revoke_create
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - candidates
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CandidateGrantRevokeResponse'
          description: ''
  /api/candidates/me/micro-tasks:
    get:
      operationId: candidates_me_micro_tasks_list
      description: Candidate lists their assigned micro-task drops (Task BE-18).
      tags:
      - candidates
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/MicroTaskDropCandidate'
          description: ''
  /api/candidates/me/micro-tasks/{drop_id}/submit:
    post:
      operationId: candidates_me_micro_tasks_submit_create
      description: Candidate submits a solution to an assigned micro-task drop (Task
        BE-18).
      parameters:
      - in: path
        name: drop_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - candidates
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/MicroTaskSubmit'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/MicroTaskSubmit'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MicroTaskDropCandidate'
          description: ''
  /api/candidates/me/resume:
    post:
      operationId: candidates_me_resume_create
      tags:
      - candidates
      requestBody:
        content:
          multipart/form-data:
            schema:
              type: object
              properties:
                file:
                  type: string
                  format: binary
              required:
              - file
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ResumeParseResponse'
          description: ''
  /api/companies:
    get:
      operationId: companies_retrieve
      parameters:
      - in: query
        name: page
        schema:
          type: integer
        description: Page number (default 1)
      - in: query
        name: search
        schema:
          type: string
        description: Search companies by name for candidate blocklist (min length
          2)
        required: true
      - in: query
        name: size
        schema:
          type: integer
        description: Page size (default 20, max 100)
      tags:
      - companies
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CompanyPaginatedResponse'
          description: ''
    post:
      operationId: companies_create
      tags:
      - companies
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Company'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Company'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Company'
          description: ''
  /api/companies/me:
    get:
      operationId: companies_me_retrieve
      tags:
      - companies
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Company'
          description: ''
    put:
      operationId: companies_me_update
      tags:
      - companies
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Company'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Company'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Company'
          description: ''
  /api/demo/persona:
    post:
      operationId: demo_persona_create
      description: 'Switch or login as demo personas: candidate_fsp, candidate_plain,
        employer.'
      tags:
      - demo
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PersonaRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PersonaRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MeResponse'
          description: ''
  /api/demo/reset:
    post:
      operationId: demo_reset_create
      description: Resets the caller's persona data and clock offset in DEMO_MODE.
      tags:
      - demo
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/DemoResetResponse'
          description: ''
  /api/demo/time-travel:
    post:
      operationId: demo_time_travel_create
      description: Time-travel endpoint for jury/demo testing cooldowns.
      tags:
      - demo
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TimeTravelRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/TimeTravelRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TimeTravelResponse'
          description: ''
  /api/events:
    get:
      operationId: events_retrieve
      description: Server-Sent Events (SSE) notification stream
      tags:
      - events
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            text/event-stream:
              schema:
                type: string
          description: ''
  /api/fsp/link:
    post:
      operationId: fsp_link_create
      tags:
      - fsp
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/FSPLinkRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/FSPLinkRequest'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FSPLinkResponse'
          description: ''
  /api/fsp/sync:
    post:
      operationId: fsp_sync_create
      description: Trigger background or immediate sync of FSP achievements.
      tags:
      - fsp
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FSPSyncResponse'
          description: ''
  /api/lab/families:
    get:
      operationId: lab_families_retrieve
      description: Lab catalog endpoint returning all registered question families
        with empirical exposure & drift.
      tags:
      - lab
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LabFamiliesResponse'
          description: ''
  /api/lab/report:
    get:
      operationId: lab_report_retrieve
      description: |-
        Validation Lab metrics report (G11).

        Serves validation/out/report.json if present; otherwise serves
        report.fixture.json labeled with synthetic_fixture=True.
        A corrupt report gives a logged 500 report_unreadable.
      tags:
      - lab
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationReport'
          description: ''
  /api/lab/twins:
    get:
      operationId: lab_twins_retrieve
      description: |-
        Lab twin-generator endpoint for side-by-side verification of difficulty matching.

        Produces two unique rendered instances with identical parameters without leaking answers.
      parameters:
      - in: query
        name: grade
        schema:
          type: string
      - in: query
        name: position_id
        schema:
          type: string
      - in: query
        name: specialization
        schema:
          type: string
      tags:
      - lab
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LabTwinsResponse'
          description: ''
  /api/leagues:
    get:
      operationId: leagues_list
      description: League shelves with candidate counts and median salary expectation
        (G7).
      parameters:
      - in: query
        name: specialization
        schema:
          type: string
        description: Specialization to filter by
      tags:
      - leagues
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/LeagueShelf'
          description: ''
  /api/me:
    get:
      operationId: me_retrieve
      tags:
      - me
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MeResponse'
          description: ''
  /api/micro-tasks:
    get:
      operationId: micro_tasks_list
      description: Employer lists or creates company micro-tasks (Task BE-18).
      tags:
      - micro-tasks
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/MicroTask'
          description: ''
    post:
      operationId: micro_tasks_create
      description: Employer lists or creates company micro-tasks (Task BE-18).
      tags:
      - micro-tasks
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/MicroTaskCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/MicroTaskCreate'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MicroTask'
          description: ''
  /api/micro-tasks/{id}:
    get:
      operationId: micro_tasks_retrieve
      description: Employer retrieves or deletes a micro-task (Task BE-18).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - micro-tasks
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MicroTask'
          description: ''
    delete:
      operationId: micro_tasks_destroy
      description: Employer retrieves or deletes a micro-task (Task BE-18).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - micro-tasks
      security:
      - cookieAuth: []
      responses:
        '204':
          description: No response body
  /api/micro-tasks/{id}/submissions:
    get:
      operationId: micro_tasks_submissions_list
      description: Employer views all candidate submissions for a micro-task (Task
        BE-18).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - micro-tasks
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/MicroTaskSubmissionEmployer'
          description: ''
  /api/micro-tasks/submissions/{drop_id}/prefill-offer:
    post:
      operationId: micro_tasks_submissions_prefill_offer_create
      description: Prefills a Draft Offer from a candidate's micro-task submission
        (Task BE-18).
      parameters:
      - in: path
        name: drop_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - micro-tasks
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MicroTaskPrefillOfferResponse'
          description: ''
  /api/micro-tasks/submissions/{drop_id}/rate:
    post:
      operationId: micro_tasks_submissions_rate_create
      description: Employer rates a candidate's micro-task submission (Task BE-18).
      parameters:
      - in: path
        name: drop_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - micro-tasks
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/MicroTaskRate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/MicroTaskRate'
        required: true
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/MicroTaskSubmissionEmployer'
          description: ''
  /api/offers:
    get:
      operationId: offers_list
      tags:
      - offers
      security:
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OfferPaginatedResponse'
          description: ''
    post:
      operationId: offers_create
      tags:
      - offers
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateOffer'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CreateOffer'
        required: true
      security:
      - cookieAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Offer'
          description: ''
  /api/offers/{id}:
    get:
      operationId: offers_retrieve
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - offers
      security:
