# FSP Draft — environment variables
# Copy to .env and adjust values.

# --- Core ---
SECRET_KEY=change-me-to-a-random-64-char-string
DEBUG=False
DEMO_MODE=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
POSTGRES_DB=fsp_draft
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- OIDC / FSP ID ---
OIDC_ISSUER=http://localhost:8090/realms/fsp
OIDC_CLIENT_ID=fsp-draft
OIDC_CLIENT_SECRET=dev-secret
FSP_REGISTRY_URL=http://localhost:8090/registry/v1

# --- LLM ---
LLM_PROVIDER=fake
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=

# --- Email (MailHog / dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@fsp-draft.local

# --- Item seed secret (HMAC) ---
ITEM_SEED_SECRET=change-me-to-a-random-string

# --- Cooldowns (days) ---
GRADE_RETRY_COOLDOWN_DAYS=30
GRADE_PROMOTION_COOLDOWN_DAYS=90
