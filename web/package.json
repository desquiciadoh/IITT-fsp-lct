    "lucide-react": "^0.544.0",
    "radix-ui": "^1.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
