    "js-yaml": "^4.1.0",
    "jsdom": "^30.1.2",
    "msw": "^2.8.11",
    "orval": "^7.9.0",
    "prettier": "^3.6.2",
    "shiki": "^3.6.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
